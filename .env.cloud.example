# Copiar a .env.cloud (ignorado por Git). No compartir el archivo completo.
# Usar el endpoint DNS de RDS, nunca una IP ni el endpoint de EC2.
RDS_HOST=REEMPLAZAR_ENDPOINT_RDS
RDS_PORT=3306
RDS_DB_USER=p360_app
RDS_DB_PASSWORD='REEMPLAZAR_CONTRASENA_PRIVADA'
# update crea/actualiza tablas sin borrar las bases. No usar create ni create-drop.
RDS_DDL_AUTO=update
